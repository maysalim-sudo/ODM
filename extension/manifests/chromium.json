{
  "manifest_version": 3,
  "name": "ODM",
  "version": "0.1.0",
  "description": "Send downloads to ODM (Open Downloader Manager).",
  "permissions": ["downloads", "cookies", "nativeMessaging", "contextMenus", "storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true }
  ],
  "action": { "default_popup": "popup.html", "default_title": "ODM" },
  "icons": { "32": "icons/32.png", "128": "icons/128.png" },
  "minimum_chrome_version": "116"
}
