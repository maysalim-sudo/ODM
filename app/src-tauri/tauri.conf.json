{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ODM",
  "mainBinaryName": "ODM",
  "version": "0.2.0",
  "identifier": "com.odm.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ODM",
        "width": 1180,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Salim May",
    "copyright": "© 2026 Salim May. MIT License.",
    "homepage": "https://github.com/salimmay/ODM",
    "shortDescription": "A personal download manager for Windows and Linux.",
    "category": "Utility",
    "longDescription": "ODM (Open Downloader Manager) downloads files over several connections at once, resumes after a pause or a crash, and keeps a queue with speed and concurrency limits. It takes over downloads from Chrome, Edge, Brave, Vivaldi, Opera, Firefox and Floorp, and finds the videos a page plays.",
    "licenseFile": "../../LICENSE",
    "externalBin": ["binaries/odm-host"],
    "resources": {
      "../../extension/dist/chromium/": "extension/chromium/",
      "../../extension/dist/firefox/": "extension/firefox/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    },
    "linux": {
      "deb": { "desktopTemplate": "linux/odm.desktop" },
      "rpm": { "desktopTemplate": "linux/odm.desktop" }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/salimmay/ODM/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
